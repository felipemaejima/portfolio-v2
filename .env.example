# Copie para .env. Nunca commite o .env.

# --- db ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# --- api ---
PORT=3000
DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio
DATABASE_URL_TEST=postgresql://portfolio:portfolio@db:5432/portfolio_test
JWT_ACCESS_SECRET=troque-por-32-bytes-aleatorios-em-base64
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=
UPLOADS_DIR=/data/uploads
PUBLIC_UPLOADS_BASE_URL=http://localhost/uploads
MAX_UPLOAD_BYTES=5242880
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# --- edge ---
SITE_ADDRESS=:80

# --- portas expostas no host (dev) ---
EDGE_PORT=80
API_PORT=3000
DB_PORT=5432

# --- dono dos arquivos criados pelos containers de dev (id -u / id -g) ---
HOST_UID=1000
HOST_GID=1000

# --- toolchain flutter ---
FLUTTER_VERSION=stable
