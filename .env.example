# Copie para .env (make setup faz isso e gera o JWT_ACCESS_SECRET). Nunca commite o .env.
# Em PRODUÇÃO a API recusa subir com os valores de exemplo ("troque-…"), com
# COOKIE_SECURE=false ou com PUBLIC_UPLOADS_BASE_URL sem https. Use `make secret`.

# --- db ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# --- api ---
PORT=3000
DATABASE_URL=postgresql://portfolio:portfolio@db:5432/portfolio
DATABASE_URL_TEST=postgresql://portfolio:portfolio@db:5432/portfolio_test
JWT_ACCESS_SECRET=troque-por-32-bytes-aleatorios-em-base64
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=
UPLOADS_DIR=/data/uploads
PUBLIC_UPLOADS_BASE_URL=http://localhost/uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha

# --- edge ---
SITE_ADDRESS=:80

# --- portas expostas no host (dev) ---
EDGE_PORT=80
API_PORT=3000
DB_PORT=5432

# --- toolchain flutter ---
FLUTTER_VERSION=3.44.0
