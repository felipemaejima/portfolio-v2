{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Falha de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Autentica o Admin. WEB recebe o refresh em cookie httpOnly; MOBILE, no body.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Falha de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Rotaciona o refresh (cookie primeiro, body como fallback) e devolve um par novo.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoga a família do refresh atual e limpa o cookie.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "O Admin autenticado. O app usa no boot para validar a sessão.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Dados de apresentação do Admin (seção \"Sobre\"). Nunca expõe credenciais.",
        "tags": [
          "profile"
        ]
      },
      "put": {
        "operationId": "updateProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Falha de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Substitui o Profile inteiro.",
        "tags": [
          "profile"
        ]
      }
    },
    "/api/v1/profile/image": {
      "put": {
        "operationId": "updateProfileImage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileDto"
                }
              }
            }
          },
          "400": {
            "description": "Requisição malformada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "413": {
            "description": "Arquivo acima do limite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de arquivo não aceito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Substitui a foto (multipart, campo `file`; jpeg/png/webp até 5 MB).",
        "tags": [
          "profile"
        ]
      },
      "delete": {
        "operationId": "deleteProfileImage",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Remove a foto.",
        "tags": [
          "profile"
        ]
      }
    }
  },
  "info": {
    "title": "Portfolio API",
    "description": "Contrato da API do portfólio. Ver .specs/GLOBAL.md.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ClientPlatform": {
        "type": "string",
        "enum": [
          "WEB",
          "MOBILE"
        ],
        "description": "WEB → refresh em cookie httpOnly; MOBILE → refresh no body."
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string"
          },
          "clientPlatform": {
            "description": "WEB → refresh em cookie httpOnly; MOBILE → refresh no body.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClientPlatform"
              }
            ]
          }
        },
        "required": [
          "email",
          "password",
          "clientPlatform"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Segundos até o access token expirar.",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Presente só para MOBILE; no WEB o refresh viaja em cookie httpOnly."
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "NOT_FOUND",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "INTERNAL"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 422
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Texto exibível, em PT-BR.",
            "example": "Dados inválidos."
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Só em VALIDATION_FAILED: mensagens por campo.",
            "example": {
              "email": [
                "deve ser um e-mail válido"
              ]
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Só para MOBILE. No WEB o refresh vem no cookie e o body é vazio."
          }
        }
      },
      "AdminDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@example.com"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "maxLength": 80,
            "example": "São Paulo"
          },
          "state": {
            "type": "string",
            "maxLength": 80,
            "example": "SP"
          },
          "country": {
            "type": "string",
            "maxLength": 80,
            "example": "Brasil"
          }
        },
        "required": [
          "city",
          "state",
          "country"
        ]
      },
      "Availability": {
        "type": "string",
        "enum": [
          "CLT",
          "PJ",
          "FREELANCE",
          "CONTRACT"
        ]
      },
      "WorkMode": {
        "type": "string",
        "enum": [
          "REMOTE",
          "HYBRID",
          "ON_SITE"
        ]
      },
      "LanguageLevel": {
        "type": "string",
        "enum": [
          "BASIC",
          "INTERMEDIATE",
          "ADVANCED",
          "FLUENT",
          "NATIVE"
        ]
      },
      "LanguageDto": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "Nome do idioma, texto livre em PT-BR.",
            "maxLength": 60,
            "example": "Inglês"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LanguageLevel"
              }
            ]
          }
        },
        "required": [
          "language",
          "level"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "availability": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Availability"
            }
          },
          "workModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkMode"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageDto"
            }
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL pública permanente da foto, ou null."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "headline",
          "summary",
          "description",
          "location",
          "availability",
          "workModes",
          "languages",
          "imageUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Nome Sobrenome"
          },
          "headline": {
            "type": "string",
            "description": "Uma linha acima do nome no hero.",
            "maxLength": 160,
            "example": "Desenvolvedor Full-Stack"
          },
          "summary": {
            "type": "string",
            "description": "Parágrafo curto do hero.",
            "maxLength": 600
          },
          "description": {
            "type": "string",
            "description": "Texto longo do \"Sobre mim\"; parágrafos separados por linha em branco.",
            "maxLength": 5000
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "availability": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Availability"
            }
          },
          "workModes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/WorkMode"
            }
          },
          "languages": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageDto"
            }
          }
        },
        "required": [
          "name",
          "headline",
          "summary",
          "description",
          "location",
          "availability",
          "workModes",
          "languages"
        ]
      }
    }
  }
}
