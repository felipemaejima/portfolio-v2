        "summary": "Ordem da galeria: o conjunto completo de ids das imagens na ordem final.",
        "tags": [
          "projects"
        ]
      }
    }
  },
  "info": {
    "title": "Portfolio API",
    "description": "Contrato da API do portfólio. Ver .specs/GLOBAL.md.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ClientPlatform": {
        "type": "string",
        "enum": [
          "WEB",
          "MOBILE"
        ],
        "description": "WEB → refresh em cookie httpOnly; MOBILE → refresh no body."
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string"
          },
          "clientPlatform": {
            "description": "WEB → refresh em cookie httpOnly; MOBILE → refresh no body.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClientPlatform"
              }
            ]
          }
        },
        "required": [
          "email",
          "password",
          "clientPlatform"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Segundos até o access token expirar.",
            "example": 900
          },
          "refreshToken": {
            "type": "string",
            "description": "Presente só para MOBILE; no WEB o refresh viaja em cookie httpOnly."
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "NOT_FOUND",
          "PAYLOAD_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "INTERNAL"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 422
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              }
            ]
          },
          "message": {
            "type": "string",
            "description": "Texto exibível, em PT-BR.",
            "example": "Dados inválidos."
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Só em VALIDATION_FAILED: mensagens por campo.",
            "example": {
              "email": [
                "deve ser um e-mail válido"
              ]
            }
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Só para MOBILE. No WEB o refresh vem no cookie e o body é vazio."
          }
        }
      },
      "AdminDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@example.com"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "maxLength": 80,
            "example": "São Paulo"
          },
          "state": {
            "type": "string",
            "maxLength": 80,
            "example": "SP"
          },
          "country": {
            "type": "string",
            "maxLength": 80,
            "example": "Brasil"
          }
        },
        "required": [
          "city",
          "state",
          "country"
        ]
      },
      "Availability": {
        "type": "string",
        "enum": [
          "CLT",
          "PJ",
          "FREELANCE",
          "CONTRACT"
        ]
      },
      "WorkMode": {
        "type": "string",
        "enum": [
          "REMOTE",
          "HYBRID",
          "ON_SITE"
        ]
      },
      "LanguageLevel": {
        "type": "string",
        "enum": [
          "BASIC",
          "INTERMEDIATE",
          "ADVANCED",
          "FLUENT",
          "NATIVE"
        ]
      },
      "LanguageDto": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "Nome do idioma, texto livre em PT-BR.",
            "maxLength": 60,
            "example": "Inglês"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LanguageLevel"
              }
            ]
          }
        },
        "required": [
          "language",
          "level"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "availability": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Availability"
            }
          },
          "workModes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkMode"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageDto"
            }
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL pública permanente da foto, ou null."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "headline",
          "summary",
          "description",
          "location",
          "availability",
          "workModes",
          "languages",
          "imageUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Nome Sobrenome"
          },
          "headline": {
            "type": "string",
            "description": "Uma linha acima do nome no hero.",
            "maxLength": 160,
            "example": "Desenvolvedor Full-Stack"
          },
          "summary": {
            "type": "string",
            "description": "Parágrafo curto do hero.",
            "maxLength": 600
          },
          "description": {
            "type": "string",
            "description": "Texto longo do \"Sobre mim\"; parágrafos separados por linha em branco.",
            "maxLength": 5000
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "availability": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Availability"
            }
          },
          "workModes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/WorkMode"
            }
          },
          "languages": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageDto"
            }
          }
        },
        "required": [
          "name",
          "headline",
          "summary",
          "description",
          "location",
          "availability",
          "workModes",
          "languages"
        ]
      },
      "ProjectImageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "URL pública permanente."
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "url",
          "position"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "Identificador público na rota de detalhe; imutável.",
            "example": "portfolio-api"
          },
          "shortDescription": {
            "type": "string"
          },
          "fullDescription": {
            "type": "string"
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "codeUrl": {
            "type": "string",
            "nullable": true
          },
          "demoUrl": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "integer"
          },
          "images": {
            "description": "Galeria, por `position`. A primeira é a capa.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectImageDto"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "shortDescription",
          "fullDescription",
          "technologies",
          "codeUrl",
          "demoUrl",
          "position",
          "images",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectInputDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Portfolio API"
          },
          "shortDescription": {
            "type": "string",
            "description": "Usada na listagem/cards.",
            "maxLength": 300
          },
          "fullDescription": {
            "type": "string",
            "description": "Usada no detalhe.",
            "maxLength": 10000
          },
          "technologies": {
            "maxItems": 30,
            "example": [
              "NestJS",
              "Flutter"
            ],
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "codeUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "example": "https://github.com/x/y"
          },
          "demoUrl": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          }
        },
        "required": [
          "name",
          "shortDescription",
          "fullDescription",
          "technologies"
        ]
      },
      "ReorderDto": {
        "type": "object",
        "properties": {
          "ids": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "ids"
        ]
      }
    }
  }
}
