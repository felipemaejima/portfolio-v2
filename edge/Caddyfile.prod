{$SITE_ADDRESS}

# Headers de segurança para tudo (app, API e uploads).
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
}

handle /api/* {
	reverse_proxy api:3000
}

handle_path /uploads/* {
	root * /data/uploads
	file_server
	header Cache-Control "public, max-age=31536000, immutable"
}

handle {
	root * /srv
	try_files {path} /index.html
	# Flutter Web: CanvasKit/Skwasm e fontes são 'self' (--no-web-resources-cdn).
	# 'wasm-unsafe-eval' é o mínimo para instanciar Wasm; 'unsafe-inline' em
	# style é exigido pelo engine (estilos inline no DOM). Sem inline scripts.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	# Nenhum arquivo do build tem hash no nome e o service worker do Flutter não
	# cacheia mais: o cache HTTP revalida sempre (ETag → 304, barato) para o app
	# nunca ficar velho após um deploy.
	header Cache-Control "no-cache"
	file_server {
		precompressed br gzip
	}
}

encode zstd gzip
