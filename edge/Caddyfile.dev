{$SITE_ADDRESS}

handle /api/* {
	reverse_proxy api:3000
}

handle_path /uploads/* {
	root * /data/uploads
	file_server
	header Cache-Control "public, max-age=31536000, immutable"
}

# `app` é o dev server do Flutter (make app-dev) ou o preview do build de
# release (make preview) — os dois respondem pelo mesmo alias de rede.
handle {
	reverse_proxy app:8080
}

encode zstd gzip
